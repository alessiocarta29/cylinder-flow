FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (1 0 0);            // free-stream start; steady solution does not depend on it

boundaryField
{
    inlet
    {
        type    fixedValue;
        value   uniform (1 0 0);
    }

    outlet
    {
        type    zeroGradient;
    }

    cylinder
    {
        type    noSlip;
    }

    top          { type symmetryPlane; }
    bottom       { type symmetryPlane; }
    frontAndBack { type empty; }
}
