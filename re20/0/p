FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];           // kinematic pressure, p/rho

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type    zeroGradient;
    }

    outlet
    {
        type    zeroGradient;
    }

    cylinder
    {
        type    zeroGradient;
    }

    top          { type symmetryPlane; }
    bottom       { type symmetryPlane; }
    frontAndBack { type empty; }
}
