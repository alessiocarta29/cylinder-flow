FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p
    {
        solver          PCG;
        preconditioner  DIC;


        tolerance       1e-10;
        relTol          0.01;
    }

    U
    {
  
        solver          smoothSolver;
        smoother        symGaussSeidel;

        tolerance       1e-10;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors  0;
    consistent                no;       // no = SIMPLE, yes = SIMPLEC

    pRefPoint (-15 1 0.5);         // or replace this line with: pRefPoint (X Y Z);
    pRefValue                 0;

    residualControl
    {
        p                     1e-7;
        U                     1e-7;
    }
}

relaxationFactors
{
    fields
    {
        p                     0.2;          // explicit, Ferziger eq. 5.71
    }
    equations
    {
        U                     0.8;          // implicit, Ferziger eq. 5.73
    }
}
