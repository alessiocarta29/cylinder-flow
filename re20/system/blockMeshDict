FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Grid parameters: level 1 of the family in Ferziger et al., sec. 9.12.
// scripts/grid_study.py overwrites these three entries for levels 2-5.
nTheta          6;                  // cells per block around the cylinder (4 blocks)
nR              16;                 // radial cells
radialGrading   28.4217094304;      // last/first radial cell size = r^(nR-1); r = 1.25 on level 1

scale 1;

vertices
(
    (-0.353553390593 -0.353553390593 0)    // 0  cylinder, 225 deg
    ( 0.353553390593 -0.353553390593 0)    // 1  cylinder, 315 deg
    ( 0.353553390593  0.353553390593 0)    // 2  cylinder, 45 deg
    (-0.353553390593  0.353553390593 0)    // 3  cylinder, 135 deg
    (-16 -16 0)                            // 4  domain corner, bottom left
    ( 16 -16 0)                            // 5  domain corner, bottom right
    ( 16  16 0)                            // 6  domain corner, top right
    (-16  16 0)                            // 7  domain corner, top left

    (-0.353553390593 -0.353553390593 1)    // 8  back plane, as 0
    ( 0.353553390593 -0.353553390593 1)    // 9  back plane, as 1
    ( 0.353553390593  0.353553390593 1)    // 10 back plane, as 2
    (-0.353553390593  0.353553390593 1)    // 11 back plane, as 3
    (-16 -16 1)                            // 12 back plane, as 4
    ( 16 -16 1)                            // 13 back plane, as 5
    ( 16  16 1)                            // 14 back plane, as 6
    (-16  16 1)                            // 15 back plane, as 7
);

// x1 radial (outward), x2 around the cylinder (counter-clockwise), x3 span
blocks
(
    hex (0 4 5 1 8 12 13 9)   ($nR $nTheta 1) simpleGrading ($radialGrading 1 1)    // bottom
    hex (1 5 6 2 9 13 14 10)  ($nR $nTheta 1) simpleGrading ($radialGrading 1 1)    // right
    hex (2 6 7 3 10 14 15 11) ($nR $nTheta 1) simpleGrading ($radialGrading 1 1)    // top
    hex (3 7 4 0 11 15 12 8)  ($nR $nTheta 1) simpleGrading ($radialGrading 1 1)    // left
);

edges
(
    arc 0 1   (0 -0.5 0)
    arc 1 2   (0.5 0 0)
    arc 2 3   (0 0.5 0)
    arc 3 0   (-0.5 0 0)

    arc 8 9   (0 -0.5 1)
    arc 9 10  (0.5 0 1)
    arc 10 11 (0 0.5 1)
    arc 11 8  (-0.5 0 1)
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (7 4 12 15)
        );
    }

    outlet
    {
        type patch;
        faces
        (
            (5 6 14 13)
        );
    }

    top
    {
        type symmetryPlane;
        faces
        (
            (6 7 15 14)
        );
    }

    bottom
    {
        type symmetryPlane;
        faces
        (
            (4 5 13 12)
        );
    }

    cylinder
    {
        type wall;
        faces
        (
            (0 8 9 1)
            (1 9 10 2)
            (2 10 11 3)
            (3 11 8 0)
        );
    }
);

defaultPatch
{
    name frontAndBack;
    type empty;
}
