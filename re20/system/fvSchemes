FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;
    div(phi,U)      bounded Gauss deferredCorrection linear;   // CDS with deferred correction (Ferziger eq. 8.22)
    div((nuEff*dev2(T(grad(U))))) Gauss linear;                // explicit viscous part, vanishes for constant nu
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}
